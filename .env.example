# Flask Secret Key (Change this to a random secure string in production)
SECRET_KEY=your-super-secret-key-here

# ── MySQL Database ──────────────────────────────────────────
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fastag_portal

# ── Flask-Mail (SMTP) ───────────────────────────────────────
# For development, reset links are printed to the console.
# Fill these in to send real emails (e.g. Gmail SMTP).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# ── OTP ─────────────────────────────────────────────────────
# Set to True to always use OTP_DEMO_CODE (dev only)
OTP_DEMO_MODE=True
OTP_DEMO_CODE=123456
OTP_EXPIRY_SECONDS=300

# ── Twilio (real SMS – fill when ready) ─────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=your_twilio_phone_number

# ── KYC Hashing Pepper ───────────────────────────────────────
# Secret pepper for HMAC-SHA256 hashing of Aadhaar & PAN.
# Generate a secure value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the default value in production!
KYC_PEPPER=your-random-32-byte-hex-pepper-here
